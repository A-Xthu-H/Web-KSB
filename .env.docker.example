# Contoh environment untuk docker compose (salin jadi .env di root, lalu sesuaikan)
MYSQL_ROOT_PASSWORD=rootpassword_ganti_ini
DB_NAME=klinik_sehat_bagendit

# JWT — WAJIB diganti dengan string acak panjang di produksi
JWT_SECRET=ganti_dengan_string_acak_panjang_minimal_32_karakter

# CORS — alamat frontend yang diizinkan
CORS_ORIGIN=http://localhost:8080

# Gunakan origin yang sama agar Nginx meneruskan /api ke container backend.
VITE_API_URL=/

# Cloudinary (opsional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

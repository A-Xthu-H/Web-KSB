PORT=3000
NODE_ENV=development

# Database (MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=klinik_sehat_bagendit
DB_USER=root
DB_PASSWORD=
DB_DIALECT=mysql
DB_LOGGING=false

# JWT
JWT_SECRET=ubah_secret_ini_di_produksi
JWT_EXPIRES_IN=1d

# CORS
CORS_ORIGIN=http://localhost:5173
# Set true untuk menyajikan hasil build frontend dari server ini (deployment satu server)
SERVE_FRONTEND=false
# Cloudinary (opsional — jika kosong, upload memakai penyimpanan lokal)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Seed admin default (npm run seed)
SEED_ADMIN_EMAIL=admin@kliniksehatbagendit.com
SEED_ADMIN_PASSWORD=admin12345

# =====================================================================
# CONTOH KONFIGURASI PRODUKSI — backend/.env.production.example
# Salin ke backend/.env (JANGAN commit .env ke Git).
# =====================================================================

# Server
PORT=3000
NODE_ENV=production

# Database MySQL (server produksi / cloud)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=klinik_sehat_bagendit
DB_USER=ksb_user
DB_PASSWORD=ganti_password_kuat_disini
DB_DIALECT=mysql
DB_LOGGING=false

# JWT — WAJIB string acak panjang (minimal 32 karakter).
# Buat dengan: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=GANTI_DENGAN_STRING_ACAK_PANJANG
JWT_EXPIRES_IN=1d

# CORS — domain frontend produksi
CORS_ORIGIN=https://domain-anda.com

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Set true bila backend juga menyajikan frontend build (deployment satu server)
SERVE_FRONTEND=false

# Akun admin awal (untuk `npm run seed`)
SEED_ADMIN_EMAIL=admin@kliniksehatbagendit.com
SEED_ADMIN_PASSWORD=ganti_password_admin_kuat
